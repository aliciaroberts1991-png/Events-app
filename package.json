{
  "name": "quartet-events",
  "version": "1.0.0",
  "private": true,
  "description": "Quartet — personal events discovery and planning for Bratislava, Vienna, Budapest, Prague, European festivals and Ibiza.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "migrate": "tsx src/server/cli.ts migrate",
    "owner:create": "tsx src/server/cli.ts owner",
    "token:create": "tsx src/server/cli.ts token",
    "demo:load": "tsx src/server/cli.ts demo-load",
    "demo:remove": "tsx src/server/cli.ts demo-remove",
    "backup": "tsx src/server/cli.ts backup",
    "docs:schema": "tsx scripts/generate-schemas.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:pg": "TEST_DATABASE=postgres vitest run",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.108.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.77.0",
    "playwright": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
