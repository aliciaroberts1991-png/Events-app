# Copy to .env (or set these in your host's dashboard). Only the first block is required.

# --- Required for a real deployment -------------------------------------------
# Owner account, created on first start if no account exists yet. After the first
# start you can remove OWNER_PASSWORD (change it later in Settings → Account).
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-to-a-long-passphrase
# The public HTTPS address, used in email links, ICS links and the OpenAPI document.
PUBLIC_URL=https://your-app.example.com

# --- Database (choose one) ------------------------------------------------------
# Default: SQLite file. Put it on a persistent volume in production.
DATABASE_URL=sqlite:/data/quartet.db
# Or PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/quartet

# --- Server ----------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Secure cookies need HTTPS. Set to false only for plain-http local testing.
COOKIE_SECURE=true
# Trust X-Forwarded-* from the hosting platform's proxy.
TRUST_PROXY=true
SESSION_DAYS=90
APP_NAME=Quartet

# --- Research integration -------------------------------------------------------
# The app queues daily discovery and weekly verification runs itself (times are set
# in Settings → Research). Turn off if an external scheduler starts runs instead.
SCHEDULER_ENABLED=true
# Minutes a claimed run may go without a heartbeat before it is marked interrupted.
RUN_LEASE_MINUTES=45
# Optional: POST a signed notification here whenever a run is queued (push mode).
# RESEARCH_WEBHOOK_URL=https://automation.example.com/hooks/quartet
# RESEARCH_WEBHOOK_SECRET=a-long-random-string

# --- Email notifications (optional, any SMTP provider) ----------------------------
# SMTP_URL=smtps://user:password@smtp.example.com:465
# or: SMTP_HOST=smtp.example.com  SMTP_PORT=587  SMTP_USER=…  SMTP_PASSWORD=…  SMTP_SECURE=false
# EMAIL_FROM="Quartet <alerts@your-domain.example>"

# --- Other -------------------------------------------------------------------------
# Load fictional demo data on start (labelled "Demo"; removable in Settings → Your data).
SEED_DEMO=false
# Allow "paste a link" extraction (the server fetches the public page you paste).
ALLOW_LINK_EXTRACTION=true
